static func stats_for_level(level: int) -> PackedInt32Array:
	var index := clampi(level - 1, 0, LEVEL_STATS.size() - 1)
	var values := PackedInt32Array(LEVEL_STATS[index])
	if level > LEVEL_STATS.size():
		var previous: Array = LEVEL_STATS[index - 1]
		for column in range(values.size()):
			values[column] += (values[column] - int(previous[column])) * (level - 60)
	return values
