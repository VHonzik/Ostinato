static func percent(attacker_level: int, defender_level: int, resistance: int, binary: bool) -> float:
	var skill := maxi(100, attacker_level * 5)
	var result := maxf(0.0, resistance) / skill * 75.0
	if not binary:
		result += 0.4 * maxi(0, defender_level * 5 - skill)
	return minf(75.0, result)


static func chances(percent_value: float) -> Array[float]:
	var value := clampf(percent_value, 0.0, 75.0)
	var low := floori(value)
	var result: Array[float] = []
	for column in range(5):
		result.append(lerpf(DISTRIBUTION[low][column], DISTRIBUTION[low + 1][column], value - low))
	return result


static func full_resist_chance(percent_value: float) -> float:
	return chances(percent_value)[4] / 100.0


static func mitigate(amount: int, percent_value: float, roll: float) -> int:
	var distribution := chances(percent_value)
	# Full resists are resolved in the spell hit roll; sample the remaining outcomes.
	var threshold := roll * (10000.0 - distribution[4])
	for portion in range(4):
		threshold -= distribution[portion]
		if threshold < 0:
			return amount - floori(amount * portion * 0.25)
	return amount - floori(amount * 0.75)
