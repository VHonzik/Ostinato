{
  "dirs": [
    "res://test"
  ],
  "include_subdirs": true,
  "prefix": "test_",
  "suffix": ".gd",
  "should_exit": true,
  "disable_colors": true,
  "no_error_tracking": false,
  "failure_error_types": [
    "engine",
