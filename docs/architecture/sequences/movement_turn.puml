@startuml
!pragma layout smetana
skinparam shadowing false
actor Player
participant MovementGame as Game
participant GridWorld as World
participant "GridActor (stable order)" as NPC
participant "GridView + Camera2D + HUD" as View

Player -> Game : Movement key(s) or Wait
alt Dead, modal UI, key echo, or unrelated input
  Game --> Player : No simulation action
else Gameplay input
  Game -> Game : Collect same-frame arrow chord
  alt Wait
    Game -> World : wait_turn()
  else Move
    Game -> World : move_player(direction)
    alt Initial hostile occupant
      World -> World : request_melee() (see combat_turn)
    else Initial tile blocked / friendly / neutral / outside map
      World --> Game : false; no time, credit, or random change
    else Legal destination
      World -> World : Add movement speed to credit
      loop Credit >= 1 and next tile legal
        World -> World : Move; spend one credit; check acquisition
      end
      note right of World
        Extra-step collisions retain unspent credit.
        Extra-step hostiles do not request an attack.
      end note
    end
  end
  opt Accepted movement / Wait
    World -> World : Increment turn; advance player swing timer
    World -> World : Acquire hostiles with range and sight
    loop Each living actor once, until player dies
      World -> NPC : Wander / pursue / return home
      World -> NPC : Advance swing; resolve due attacks
    end
    World -> World : Expire corpses, unless player died
  end
  Game -> View : Redraw; center camera; update resources / turn
end
@enduml
