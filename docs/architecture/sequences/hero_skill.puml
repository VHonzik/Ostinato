@startuml
!pragma layout smetana
skinparam shadowing false
actor Player
participant MovementGame as Game
participant HeroPanel as Panel
participant GridWorld as World
participant HeroState as Hero
participant "Chat + HUD" as View

Player -> Game : K / P or visible button
Game -> Game : Clear pending movement
Game -> Panel : open(world.hero, spell_book)
Panel -> Hero : Read stats and learned ranks
note over Game, Panel
Modal keys navigate UI without moving or waiting.
Tab stays inside panel; Esc closes without spending time.
end note
Player -> Panel : Click rank / Enter
Panel -> Game : cast_requested(identifier)
Game -> World : cast_skill(identifier)
World -> Hero : find_skill(identifier)
alt Unlearned rank / real spell preview
  World -> World : add_message(rejection / preview)
  World -> View : message_added
  World --> Game : false; no simulation change
else One-turn development skill
  alt Gain 450 XP
    World -> Hero : add_experience(450)
    loop Each crossed XP threshold
      Hero -> Hero : Retain excess, apply mage growth, refill resources
    end
    World -> World : Log award and each level gained
  else Death trigger
    World -> Hero : health = 0
    World -> World : Log death; discard remaining phase
  else Practice
    World -> World : Log harmless cast
  end
  World -> View : message_added
  World -> World : _finish_turn(): count turn; NPC phase only if alive
  World --> Game : true
end
Game -> View : refresh_view(): level, XP, HP, mana, turn
Game -> Panel : refresh() / close on death
opt Player died
  Game -> View : Show CombatPanel death overlay; block gameplay
end
@enduml
