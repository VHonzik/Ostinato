@startuml
!pragma layout smetana
skinparam shadowing false
actor Player
participant MovementGame as Game
participant HeroPanel as Book
participant CombatPanel as Targeting
participant GridWorld as World
participant HeroState as Hero
Player -> Game : Open spell book; choose learned rank
Game -> Book : open(hero, true)
Book -> Game : cast_requested(id)
alt Targeted damage / heal / buff
  Game -> Targeting : open_spell(world, skill)
  break Insufficient mana
    Targeting -> World : add_message(resource failure with cost/current mana)
    Targeting --> Player : Close selector; no time spent
  end
  Targeting -> World : spell_candidates(skill): relationship / range / sight
  Targeting --> Player : Last eligible same-category target, else closest
  Targeting --> Player : Enter confirms / Esc cancels without changing memory
  Player -> Targeting : Confirm target
  Targeting -> Targeting : Remember confirmed NPC and target category
  Targeting -> World : cast_skill(id, target)
else Self / development skill
  Game -> Targeting : clear_spell_target()
  Game -> World : cast_skill(id)
end
break Pet command or sourced off-GCD instant
  World -> World : Validate; command pet or resolve Judgement / cost / cooldown
  World --> Game : No turn, GCD or casting credit changes
end
World -> World : Validate; start GCD; engage harmful target
loop Cast boundaries until completion, cancellation, or death
  World -> World : Advance cast progress
  alt Channel boundary
    World -> Hero : Spend mana on first boundary only
    World -> World : Validate target; resolve only when tick interval is due
    note right: Cancellation retains ticks/cost; no credit.
  else Ordinary completion
    World -> World : Recheck target / range / sight / mana / effect eligibility / bag space
    alt Valid
      World -> Hero : Spend mana once; update casting credit
      World -> World : SpellEffects.resolve(); start family cooldown
    else Invalid
      World -> World : No cost, effect, or new credit
    end
  end
  World -> World : Shared NPC / summon phase; effects; regeneration; events
  World --> Game : Updated state
  alt Death
    Game -> Game : Replace attempt through GameSession
  else Cast remains pending
    Game --> Player : Presentation gap; Escape cancels
    Game -> World : continue_cast() if not canceled
  end
end
Game -> Game : Refresh HUD, chat, camera, selectors
@enduml
