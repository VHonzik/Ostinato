@startuml
!pragma layout smetana
skinparam shadowing false
actor Player
participant MovementGame as Game
participant CombatPanel as Panel
participant GridWorld as World
participant "HeroState / SwingTimer" as Hero
participant "GridActor / SwingTimer" as NPC
participant MeleeRules as Rules

Player -> Game : F: interact
Game -> Panel : open_interaction(world)
Panel -> World : interaction_candidates()
World --> Panel : closest; stable ties
opt Multiple candidates
  Panel --> Player : Directions / mouse select; Enter chooses; Esc cancels
  Player -> Panel : choose candidate
end
alt Friendly / empty corpse / no candidate
  Panel -> World : add_message(result)
  Panel --> Player : Chat; no dialogue or elapsed time
else Neutral / hostile
  opt Neutral
    Panel --> Player : Attack <name>? Enter attacks; Esc cancels
    Player -> Panel : confirm attack
  end
  Panel -> World : request_melee(target)
  note over Game, World : A hostile bump also requests melee directly.
  World -> World : Validate target; engage; face target
  loop Committed boundaries until swing, cancellation, invalid target, or death
    World -> Hero : advance(active=true, interval)
    opt Swing(s) due
      World -> Rules : outcome + damage (combat random stream)
      World -> NPC : apply damage
      opt NPC dies
        World -> NPC : nonblocking corpse; stop acting
        World -> Rules : kill_experience()
        World -> Hero : award once; ordinary progression
      end
    end
    World -> World : Increment elapsed turn
    loop Living NPCs in stable order; stop on player death
      World -> NPC : shortest terrain route; reroute only if next step occupied
      World -> NPC : advance swing timer; attack if ready and adjacent
      opt Attack
        World -> Rules : outcome + damage
        World -> Hero : apply damage
      end
    end
    World --> Game : resources / chat / pending target / death
    alt Player died
      Game -> Game : GameSession.restart_after_death()
      Game --> Player : Next Loop; learned ranks retained
    else Swing still pending
      Game --> Player : Waiting for swing; Esc / Cancel attack available
      alt Cancel before next boundary
        Player -> Game : Esc / Cancel attack
        Game -> World : cancel_melee()
      else Presentation gap elapsed
        Game -> World : continue_melee()
      end
    else Swing resolved or target invalid
      Game --> Player : Ready for next action; no automatic repeat
    end
  end
end
@enduml
