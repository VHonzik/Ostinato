@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

class MovementGame <<Node2D>> {
  world: GridWorld
  hero_panel: HeroPanel
  hotbar_panel: HotbarPanel
  _assign_hotbar(slot, identifier, source_hero)
  _hotbar_slot_pressed(slot)
  _input(event)
  _cast_skill(identifier)
  refresh_view()
}
class HeroPanel <<Control>> {
  cast_requested(identifier)
  choosing_slot: bool
  assignment_id: StringName
  begin_assignment(clear_slot)
  handle_assignment_key(event)
  _last_spell_by_class: Dictionary
  open(hero, spell_book)
  close()
  clear_selection()
  navigate(forward)
  change_tab(direction)
}
class GridWorld <<RefCounted>> {
  hero: HeroState
  hotbar: Array[StringName]
  hotbar_locked: bool
  assign_hotbar(slot, identifier): bool
  messages: PackedStringArray
  message_added(message)
  cast_skill(identifier): bool
  add_message(message)
  _finish_turn()
}
class HeroState <<RefCounted>> {
  level: int
  experience: int
  strength, agility, stamina: int
  intellect, spirit: int
  health, mana: int
  max_health, max_mana: int
  melee: MeleeProfile
  swing: SwingTimer
  facing: Vector2i
  learned_skills: Array
  add_experience(amount): PackedInt32Array
  learn_skill(skill): bool
  refresh_stats()
  find_skill(identifier): SkillRank
}
class HeroData <<RefCounted>> {
  {static} LEVEL_STATS
  {static} EXPERIENCE
  {static} stats_for_level(level): PackedInt32Array
}
class SkillRank <<RefCounted>> {
  id: StringName
  title, description: String
  class_tab: StringName
  rank, training_level, training_cost: int
  prerequisite, family: StringName
  cooldown_seconds: int
  effect: Effect
  development_only: bool
  target: Target
  mana_cost, range_tiles: int
  cast_seconds: float
  mana_percent: int
  free_instant: bool
  cost(hero): int
}
class HotbarPanel <<HBoxContainer>> {
  slot_pressed(slot)
  rank_dropped(slot, identifier, source_hero)
  lock_requested()
  refresh(world, options, can_activate, can_edit, choosing_slot)
}
class SkillButton <<Button>> {
  skill: SkillRank
  describe(rank_data, owner_hero)
  _get_drag_data(position)
  _make_custom_tooltip(text)
}
MovementGame *-- HotbarPanel
HotbarPanel *-- "5" SkillButton
HeroPanel *-- SkillButton : learned ranks / drag sources
HotbarPanel --> MovementGame : slot / drop / lock signals
HotbarPanel --> GlobalOptions : current activation labels
MovementGame --> GridWorld : owns
MovementGame *-- HeroPanel : modal UI
HeroPanel --> HeroState : reads
HeroPanel --> MovementGame : cast_requested
GridWorld *-- HeroState
HeroState --> HeroData : numeric baseline
HeroState *-- "2..*" SkillRank : explicit learned ranks

note bottom of HeroData
DATA-001/002: Vanilla mage rows through 60.
FR-016: repeat final growth/XP above that range.
end note
note bottom of SkillRank
85 ranks through level 10 from TrainerData / ClassSkillData.
Includes passive Parry and summons; pet commands are derived.
Training: selected class, level, previous rank and copper.
Casting retained ranks is independent of level/class.
Development: Practice / XP / Gold / Death trigger / Kill stalker.
Death trigger starts the next Loop via GameSession.
Kill stalker uses normal damage/death processing for completion QA.
Development ranks omitted from release builds.
end note
@enduml
