@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
class GridWorld {
  actors: Array[GridActor]
  hero: HeroState
  turn_count: int
  cast_skill(id, target)
  _finish_turn()
  _act_npc(actor)
}
class GridActor {
  tile: Vector2i
  alive: bool
  summon_kind: String
  summon_skill: StringName
  summon_target: int
  expires_turn: int
  health, mana: int
  ability_ready: float
  secondary_ready: int
  last_mana_turn: int
  threat, buffs, debuffs: Dictionary
}
class SummonRules <<stateless>> {
  {static} placement(world, skill)
  {static} summon(world, skill)
  {static} command(world, id, target)
  {static} act(world, actor)
  {static} enemy_target(world, actor)
  {static} refresh_auras(world)
  {static} remove(world, actor)
}
class SummonData <<source rows>> {
  {static} LEVELS
}
class ClassSpellEffects <<stateless>> {
  {static} can_apply(world, skill, target)
  {static} resolve(world, skill, target)
  {static} absorb(world, target, amount, physical)
  {static} on_melee(world, target, amount)
}
class SpellEffects {
  {static} damage(world, target, amount, title, turn, break_root, source)
  {static} heal(world, target, amount, title)
}
class SaveCodec {
  {static} capture(session)
  {static} restore(payload)
}
GridWorld o-- "0..*" GridActor : stable turn / save indexes
GridWorld --> SummonRules
GridWorld --> ClassSpellEffects
ClassSpellEffects --> SummonRules : summons / aura refresh
ClassSpellEffects --> SpellEffects : shared damage / healing
SummonRules --> SummonData : level stats
SummonRules --> GridActor : mutate ordinary actors
SummonRules --> SpellEffects : damage / kill credit
SaveCodec ..> GridActor : persist timers / resources / threat
note bottom of GridActor
At most one living pet, one Earth and one Fire totem.
Dead summons have no corpse, loot or population slot.
Loop reset replaces the actor array; ranks remain learned.
end note
@enduml
