@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 90
skinparam ranksep 60

component "Godot 4.7.2\nproject.godot" as Godot
component "Startup scene\nscenes/main.tscn\nVisible title; responsive layout" as Main
component "GUT 9.7.1\ntest/unit/test_main_scene.gd" as Tests
component "Validation\ntools/validate.ps1" as Validation
component "GUT report hook\ntools/gut_report.gd" as Hook
artifact "reports/\nLogs, JSON, JUnit XML, diagrams" as Reports

Godot --> Main : loads
Tests --> Main : instantiates and resizes
Validation --> Godot : imports, checks scripts, starts
Validation --> Tests : runs full suite
Tests --> Hook : after suite
Hook --> Reports : writes detailed test results
Validation --> Reports : checks results and writes evidence

note bottom of Main
Development setup only.
Gameplay systems are not implemented.
end note
@enduml
