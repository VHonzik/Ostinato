@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam shadowing false
component "Godot 4.7.2\nCompatibility / InputMap" as Godot
component "Main / pixel_viewport.gd\nInteger-scaled viewport" as Main
component "MovementGame\nInput, HUD, paced action boundaries\nCentered camera" as Game
component "GameSession\nGame seed / Loop / world replacement" as Session
component "GridWorld + GridActor\nMovement, melee, casts, effects\nOrdered phases / terminal outcomes / five gate arrivals" as World
component "NorthshireZone\nValley / population replacement" as Fixture
component "QuestRules + QuestData\nObjectives / eligibility / rewards" as Quests
component "HeroState + HeroData + SkillRank\nMage growth / learned ranks / spell data" as Hero
component "StarterGear\nOutfit exchange / provenance" as Gear
component "MeleeRules + MeleeProfile + SwingTimer" as Combat
component "SpellEffects + SpellResistance\nRank effects / mitigation" as Spells
component "TrainerData + ClassSkillData\nSix-class ranks through level 10" as Training
component "ClassSpellEffects + SummonRules + SummonData\nClass effects / pet commands / totem auras" as Summons
component "ItemData + MerchantData + LootData + InventoryRules\nSource catalogs / per-merchant stock / atomic transfers" as Items
component "CombatPanel + HeroPanel + HotbarPanel\nInteraction / targeting / spell book / five rank slots" as Panels
component "MenuPanel + GlobalOptions\nMain / completion / services / slots / keybindings" as Menu
component "SaveStore + SaveCodec\nFive slots / validation / restoration" as Saves
component "GridView\nShared class / distinct creature sprites\nRelationships / selected target" as View
component "Validation\nHeadless import, scripts, startup\nGUT 9.7.1 / PlantUML" as Tests
artifact "user://\nSaves and global options" as Files
Godot --> Main
Main --> Game
Game --> Session
Session --> Fixture : new game / death
Fixture --> World : constructs
Session --> World : owns current attempt
Game --> World : input / next boundary
World --> Hero
Hero --> Gear
World --> Combat
World --> Spells
World --> Summons
Spells --> Summons
World --> Items
World --> Quests
Menu --> Quests
Quests --> Items
Hero --> Items
Hero --> Training
Menu --> World : train / loot / trade / equip
Game --> Panels
Panels --> World : cast / interact / assign explicit rank
Game --> Menu
Menu --> Session : class choice / new game
Menu --> Saves : save / load
Saves --> Session : replace validated world
Saves --> World : capture / restore
Menu --> Files : global options
Saves --> Files : demo revision 6
Game --> View
View --> World
Tests --> Godot
Tests --> Session
Tests --> Saves
note bottom of World
M8-A: terminal effects stop all later stages.
Shared actor order includes pets and totems.
Six-class ranks persist; active summons reset each Loop.
end note
@enduml
